# Development only. Do not reuse these credentials outside localhost.
DATABASE_URL=postgres://jungle:jungle-local@localhost:5433/jungle?sslmode=disable
HTTP_ADDR=:8080
INSTANCE_ID=local-1
OIDC_ISSUER=http://localhost:8081/realms/jungle
OIDC_FETCH_ISSUER=http://localhost:8081/realms/jungle
OIDC_AUDIENCE=jungle-api
OIDC_ALLOW_INSECURE_HTTP=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_OUTPUT_QUEUE=wager-events.fifo
SQS_INPUT_DLQ=wager-transactions-dlq.fifo
SQS_OUTPUT_DLQ=wager-events-dlq.fifo
SQS_TRUSTED_PROVIDERS=provider-a,provider-b
WORKER_CONCURRENCY=8
# Budget: max_replicas * DB_MAX_CONNS + migrations + operators <= max_connections.
# Use the autoscaler ceiling, not the steady-state replica count.
DB_MAX_CONNS=20
OUTBOX_PUBLISH_BATCH=100
PROCESS_TIMEOUT=30s
SQS_VISIBILITY_TIMEOUT=60s
SHUTDOWN_TIMEOUT=45s
# The orchestrator kill deadline must exceed this: Compose stop_grace_period,
# Kubernetes terminationGracePeriodSeconds (default 30s is too low).
CLAIM_LEASE=60s
POLL_INTERVAL=250ms
REFERENCE_TTL=24h
REFERENCE_MAX_ATTEMPTS=12
MIGRATIONS_DIR=migrations
# Client credentials from deploy/keycloak/jungle-realm.json:
# provider-a-client / provider-a-local-only
# provider-b-client / provider-b-local-only
# wallet-internal-client / wallet-internal-local-only
